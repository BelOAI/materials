% Convenience package: language setup + Academic Beamer theme
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academicbeamer}[2026/09/01 Academic Beamer presentation package]

\newif\ifac@russian
\newif\ifac@english
\newif\ifac@practice
\ac@russiantrue
\ac@practicefalse

\newcommand{\ac@shorttitle}{}

\DeclareOption{russian}{\ac@russiantrue\ac@englishfalse}
\DeclareOption{english}{\ac@englishtrue\ac@russianfalse}
\DeclareOption{practice}{\ac@practicetrue}
\DeclareOption{lecture}{\ac@practicefalse}
\ProcessOptions\relax

\newcommand{\setshorttitle}[1]{\renewcommand{\ac@shorttitle}{#1}}

\RequirePackage{cmap}
\RequirePackage[utf8]{inputenc}

\ifac@russian
  \RequirePackage[T2A]{fontenc}
  \RequirePackage[english,russian]{babel}
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage[english]{babel}
\fi

\usetheme{Academic}
\ifac@practice
  \usecolortheme{AcademicPractice}
\fi

\endinput
