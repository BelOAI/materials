% Academic Beamer color theme
\ProvidesFile{beamercolorthemeAcademic.sty}[2026/09/01 Academic Beamer color theme]

\definecolor{acDark}{RGB}{23,42,74}
\definecolor{acMid}{RGB}{62,84,122}
\definecolor{acGray}{RGB}{108,115,124}
\definecolor{acLight}{RGB}{239,241,244}
\definecolor{acRule}{RGB}{198,203,210}

\setbeamercolor{structure}{fg=acDark}
\setbeamercolor{title}{fg=acDark}
\setbeamercolor{frametitle}{fg=acDark,bg=white}
\setbeamercolor{normal text}{fg=black!85}
\setbeamercolor{itemize item}{fg=acMid}
\setbeamercolor{itemize subitem}{fg=acGray}
\setbeamercolor{enumerate item}{fg=acMid}
\setbeamercolor{block title}{fg=white,bg=acDark}
\setbeamercolor{block body}{fg=black!85,bg=acLight}
