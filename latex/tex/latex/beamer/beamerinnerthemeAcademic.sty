% Academic Beamer inner theme
\ProvidesFile{beamerinnerthemeAcademic.sty}[2026/09/01 Academic Beamer inner theme]

\RequirePackage{etoolbox}

\AtBeginEnvironment{itemize}{%
  \setlength{\itemsep}{2pt plus 1pt minus 1pt}%
  \setlength{\parskip}{0pt}\setlength{\parsep}{0pt}\setlength{\topsep}{2pt}}
\AtBeginEnvironment{enumerate}{%
  \setlength{\itemsep}{2pt plus 1pt minus 1pt}%
  \setlength{\parskip}{0pt}\setlength{\parsep}{0pt}\setlength{\topsep}{2pt}}
\AtBeginEnvironment{description}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}\setlength{\topsep}{2pt}}

\setbeamertemplate{block begin}{%
  \vskip4pt%
  \begin{beamercolorbox}[colsep*=0pt,leftskip=6pt,rightskip=6pt]{block title}%
    \vskip2pt\usebeamerfont*{block title}\insertblocktitle\vskip2pt%
  \end{beamercolorbox}%
  \nointerlineskip%
  \usebeamerfont{block body}%
  \begin{beamercolorbox}[colsep*=0pt,leftskip=6pt,rightskip=6pt,vmode]{block body}%
    \vskip4pt}
\setbeamertemplate{block end}{\vskip4pt\end{beamercolorbox}\vskip4pt}

\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.12}

\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{block title}{size=\small,series=\bfseries}
\setbeamerfont{block body}{size=\small}

\setbeamertemplate{itemize item}{\raisebox{0.25ex}{\rule{1.4ex}{0.45ex}}}
\setbeamertemplate{itemize subitem}{\textendash}

\newcommand{\tbd}[1]{{\color{acGray}\itshape[#1]}}
\newcommand{\lead}[1]{{\color{acMid}\bfseries #1}}
\newcommand{\orient}{{\normalfont\small\color{acGray}\;--- ориентир}}

\newcommand{\orientnote}[1][]{%
  \vspace{0.55em}{\color{acRule}\hrule height 0.4pt}\vspace{0.35em}%
  {\scriptsize\color{acGray}\textbf{Ориентировочные значения.}
  Редакция технических требований v0.9 от 18.08.2026. Конфигурации приведены
  для планирования; допускаются эквиваленты и использование имеющегося
  оборудования. Итоговая редакция публикуется на портале \texttt{beloai.by}. #1\par}%
}

\newcommand{\photoframe}[3]{%
  \begin{tikzpicture}
    \draw[acRule,line width=0.6pt,fill=acLight] (0,0) rectangle (#1,#2);
    \draw[acRule,line width=0.4pt] (0,0) -- (#1,#2);
    \draw[acRule,line width=0.4pt] (0,#2) -- (#1,0);
    \node[fill=acLight,inner sep=3pt,align=center,text=acGray,font=\scriptsize]
      at (#1/2,#2/2) {#3};
  \end{tikzpicture}%
}

\AtBeginSection[]{%
\begin{frame}[plain]
  \vfill
  \hspace{0.05\paperwidth}\begin{minipage}{0.85\paperwidth}
    {\color{acRule}\hrule height 0.8pt}\vspace{0.7em}
    {\LARGE\bfseries\color{acDark}\insertsectionhead\par}
    \vspace{0.7em}{\color{acRule}\hrule height 0.8pt}
  \end{minipage}
  \vfill
\end{frame}}
