% Academic Beamer inner theme
\ProvidesFile{beamerinnerthemeAcademic.sty}[2026/09/01 Academic Beamer inner theme]

\RequirePackage{etoolbox}

\AtBeginEnvironment{itemize}{%
  \setlength{\itemsep}{2pt plus 1pt minus 1pt}%
  \setlength{\parskip}{0pt}\setlength{\parsep}{0pt}\setlength{\topsep}{2pt}}
\AtBeginEnvironment{enumerate}{%
  \setlength{\itemsep}{2pt plus 1pt minus 1pt}%
  \setlength{\parskip}{0pt}\setlength{\parsep}{0pt}\setlength{\topsep}{2pt}}
\AtBeginEnvironment{description}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}\setlength{\topsep}{2pt}}

% Блок отделяется от текста заголовком и интервалом, без плашек.
\setbeamertemplate{block begin}{%
  \par\vskip6pt%
  {\usebeamerfont{block title}\usebeamercolor[fg]{block title}\insertblocktitle\par}%
  \vskip3pt%
  \begingroup\usebeamerfont{block body}\RaggedRight}
\setbeamertemplate{block end}{\par\endgroup\vskip6pt}

% Таблицы растягиваются до текущей ширины, в том числе внутри колонок.
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
% Аргумент сохранён для совместимости; таблицы теперь без чередования заливок.
\newcommand{\zebra}[1]{\renewcommand{\arraystretch}{1.2}}
\newenvironment{numrows}{\par\smallskip\zebra{1}\tabularx{\linewidth}{@{}>{\bfseries}r Y@{}}}{\endtabularx\par}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.12}

\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{block body}{size=\normalsize}

\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textendash}

\newcommand{\tbd}[1]{{\color{acGray}\itshape[#1]}}
\newcommand{\lead}[1]{{\color{acMid}\bfseries #1}}
\newcommand{\orient}{{\normalfont\small\color{acGray}\;--- ориентир}}

\newcommand{\orientnote}[1][]{%
  \par\smallskip%
  {\scriptsize\color{acGray}\textbf{Пример.} Значения приведены для иллюстрации; замените их данными своего занятия. #1\par}%
}

\newcommand{\photoframe}[3]{%
  \begin{tikzpicture}
    \draw[acRule,line width=0.6pt,fill=acLight] (0,0) rectangle (#1,#2);
    \draw[acRule,line width=0.4pt] (0,0) -- (#1,#2);
    \draw[acRule,line width=0.4pt] (0,#2) -- (#1,0);
    \node[fill=acLight,inner sep=3pt,align=center,text=acGray,font=\scriptsize]
      at (#1/2,#2/2) {#3};
  \end{tikzpicture}%
}

% Разделы остаются в структуре PDF, без дополнительных слайдов.
\AtBeginSection[]{}
