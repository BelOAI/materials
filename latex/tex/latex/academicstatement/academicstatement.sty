% BelOAI coding problem statement package — A4 print layout for home assignments
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academicstatement}[2026/09/01 Academic problem statement package]

\newif\ifacs@russian
\newif\ifacs@english
\acs@russiantrue

\newcommand{\acs@assignmentno}{}
\newcommand{\acs@assignmenttitle}{}

\DeclareOption{russian}{\acs@russiantrue\acs@englishfalse}
\DeclareOption{english}{\acs@englishtrue\acs@russianfalse}
\ProcessOptions\relax

\newcommand{\setassignmentno}[1]{\renewcommand{\acs@assignmentno}{#1}}
\newcommand{\setassignmenttitle}[1]{\renewcommand{\acs@assignmenttitle}{#1}}

\RequirePackage{cmap}
\RequirePackage[utf8]{inputenc}

\ifacs@russian
  \RequirePackage[T2A]{fontenc}
  \RequirePackage[english,russian]{babel}
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage[english]{babel}
\fi

\RequirePackage[a4paper,margin=2cm]{geometry}
\RequirePackage{microtype}
\RequirePackage{url}
% Ссылки могут переноситься и внутри длинного имени или идентификатора.
\g@addto@macro\UrlBreaks{\do\a\do\b\do\c\do\d\do\e\do\f\do\g\do\h\do\i\do\j\do\k\do\l\do\m\do\n\do\o\do\p\do\q\do\r\do\s\do\t\do\u\do\v\do\w\do\x\do\y\do\z\do\A\do\B\do\C\do\D\do\E\do\F\do\G\do\H\do\I\do\J\do\K\do\L\do\M\do\N\do\O\do\P\do\Q\do\R\do\S\do\T\do\U\do\V\do\W\do\X\do\Y\do\Z\do\0\do\1\do\2\do\3\do\4\do\5\do\6\do\7\do\8\do\9}
\Urlmuskip=0mu plus 1mu
\RequirePackage{needspace}
\RequirePackage{enumitem}
\emergencystretch=1em
\widowpenalty=10000
\clubpenalty=10000
\RequirePackage{xcolor}
\RequirePackage{listings}

\definecolor{acs@accent}{HTML}{555555}
\definecolor{acs@accentdark}{HTML}{222222}
\definecolor{acs@rule}{HTML}{C6CBD2}
\definecolor{acs@fill}{HTML}{FFFFFF}
\definecolor{acs@codebg}{HTML}{F4F4F4}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}

\def\subtitle#1{\def\@subtitle{#1}}
\def\@subtitle{}

\setlist[itemize]{leftmargin=1.5em, topsep=0.25em, itemsep=0.15em}
\setlist[enumerate]{leftmargin=1.5em, topsep=0.25em, itemsep=0.15em}

\lstset{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{acs@codebg},
  frame=none,
  rulecolor=\color{acs@rule},
  framerule=0.4pt,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  aboveskip=0.5em,
  belowskip=0.5em,
}

\renewcommand{\maketitle}{%
  \begingroup
  \color{acs@accentdark}%
  {\large\bfseries BelOAI}%
  \ifx\acs@assignmentno\empty\else
    \hfill{\small\color{acs@accent}\ifacs@russian Домашнее задание\else Assignment\fi~\acs@assignmentno}%
  \fi
  \par\vspace{0.4em}%
  {\LARGE\bfseries\@title\par}%
  \ifx\@subtitle\empty\else
    {\large\color{acs@accent}\@subtitle\par}%
  \fi
  \ifx\acs@assignmenttitle\empty\else
    {\normalsize\acs@assignmenttitle\par}%
  \fi
  \vspace{0.2em}%
  {\small\color{acs@accent}\@author \quad\textbar\quad \@date}%
  \par\vspace{0.8em}%
  \vspace{0.6em}%
  \endgroup
}

\newcommand{\acs@blocktitle}[1]{%
  \par\vspace{0.4em}%
  \textbf{\color{acs@accentdark}#1}%
  \par\vspace{0.2em}%
}

\newenvironment{problem}{%
  \acs@blocktitle{\ifacs@russian Условие\else Problem\fi}%
}{%
  \par
}

\newenvironment{io}{%
  \acs@blocktitle{\ifacs@russian Формат ввода и вывода\else Input / Output\fi}%
}{%
  \par
}

\newenvironment{example}{%
  \par\vspace{0.4em}%
  \acs@blocktitle{\ifacs@russian Пример\else Example\fi}%
}{%
  \par\vspace{0.25em}%
}

\newenvironment{constraints}{%
  \acs@blocktitle{\ifacs@russian Ограничения\else Constraints\fi}%
  \begin{itemize}%
}{%
  \end{itemize}%
}

\newcommand{\sampleio}[2]{%
  \par\noindent\textbf{\ifacs@russian Вход:\else Input:\fi}\par
  \lstinline|#1|\par
  \noindent\textbf{\ifacs@russian Выход:\else Output:\fi}\par
  \lstinline|#2|\par
}

\endinput
